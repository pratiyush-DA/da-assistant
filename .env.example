# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Groq
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-8b-instant
LLM_MAX_COMPLETION_TOKENS=1024
# Keep total request under Groq TPM for your model (8b-instant on_demand = 6000)
LLM_MAX_REQUEST_TOKENS=5500
LLM_TEMPERATURE=0.2

# Mixed-client RAG routing (optional overrides)
RAG_DOMAIN_CONFIDENCE_MARGIN=1.5
RAG_WORKBOOK_MIN_SCORE=2.0
RAG_MIN_DOMAIN_SCORE=2.0
RAG_DOCUMENT_AFFINITY_WEIGHT=0.15
RAG_AFFINITY_MIN_SCORE=0.3
RAG_SCORE_PERSONNEL=2.0
RAG_SCORE_STRUCT_WB=3.0
RAG_SCORE_SHEET_MATCH=3.0
RAG_SCORE_ENTITY_MATCH=3.0
RAG_SCORE_ENTITY_MISS=2.0
MIXED_NARRATIVE_TOKEN_FLOOR_RATIO=0.4

# Embeddings (local OSS via LangChain; Groq does not provide embeddings)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
RERANK_ENABLED=false

# Storage
STORAGE_BACKEND=local
MEDIA_ROOT=/data/uploads

# Chunking
PARENT_CHUNK_TOKENS=2000
CHILD_CHUNK_TOKENS=200

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker API startup (see README — fast restarts use defaults below)
# Set to 1 for one-shot init via: docker compose up -d (then set back to 0)
DOCKER_RUN_MIGRATE=1
DOCKER_INIT_NEO4J_SCHEMA=0
DOCKER_SEED_CLIENTS=0
DOCKER_STARTUP_RETRIES=10
